/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; child-src 'self' blob:; connect-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/ds/v1/*
  Cache-Control: public, max-age=31536000, immutable

# Runtime assets live under a path that names the package version (prepare-assets.mjs), so
# they can be immutable: a new version is a new path, and nobody re-downloads 33 MB a day later.
/ocr/*
  Cache-Control: public, max-age=31536000, immutable

/mediapipe/*
  Cache-Control: public, max-age=31536000, immutable

/c2pa/*
  Cache-Control: public, max-age=31536000, immutable

/zxing/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=604800
