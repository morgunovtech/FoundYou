public/ocr/*
!public/ocr/.gitkeep
public/mediapipe/
public/c2pa/
public/zxing/

# Cloudflare (wrangler / Pages Functions local secrets)
.dev.vars
.wrangler/

# Local browser-smoke fixtures (HEIC/JPEG samples) — never commit
public/test/
